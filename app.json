{
  "expo": {
    "name": "Buscar clientes",
    "slug": "Buscar-clientes",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/clientsearch.png",
    "scheme": "buscarclientes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erick.sandoval10.Buscarclientes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta app necesita tu ubicación para poder calcular la ruta hacia el cliente.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/clientsearch.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.erick.sandoval10.Buscarclientes",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_INSTALL_PACKAGES",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/clientsearch.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clientsearch.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir a la aplicación rastrear la ruta en segundo plano para la logística de ventas."
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b9e1d34-d6c9-4f8c-b43d-5f0f87eeb3b5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7b9e1d34-d6c9-4f8c-b43d-5f0f87eeb3b5"
    }
  }
}